{
  "name": "cloud-sentinel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed": "node scripts/seed-localstack.ts",
    "seed:down": "node scripts/seed-localstack.ts --teardown",
    "seed:list": "node scripts/seed-localstack.ts --list",
    "collect": "node scripts/collect.ts",
    "scan": "node scripts/scan.ts",
    "scan:fixture": "node scripts/scan.ts --input fixtures/inventory.json",
    "test": "node --test \"lib/**/*.test.ts\" \"fixtures/**/*.test.ts\"",
    "db:migrate": "node scripts/db.ts migrate",
    "db:status": "node scripts/db.ts status",
    "relock": "docker run --rm -v .:/app -w /app node:24-slim npm install --package-lock-only"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1116.0",
    "@aws-sdk/client-iam": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.1116.0",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
